         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Efficiency of Public Expenditure in Education and Health</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This paper measures the efficiency of public spending in the education and health sectors using Stochastic Frontier Analysis (SFA) and Data Envelopment Analysis (DEA).</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>European Commission, Economic and Financial Affairs, European Economy, Disucssion Paper</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>H40 (Publicly Provided Goods - General)</rdf:li>
               <rdf:li>H51 (National Government Expenditures and Health)</rdf:li>
               <rdf:li>H52 (National Government Expenditures and Education)</rdf:li>
               <rdf:li>I11 (Analysis of Health Care Markets)</rdf:li>
               <rdf:li>I21 (Analysis of Education)</rdf:li>
               <rdf:li>-------------------------------</rdf:li>
               <rdf:li>Efficiency analysis</rdf:li>
               <rdf:li>SFA</rdf:li>
               <rdf:li>DEA</rdf:li>
               <rdf:li>Malmquist index</rdf:li>
               <rdf:li>education</rdf:li>
               <rdf:li>health</rdf:li>
               <rdf:li>government efficiency</rdf:li>
               <rdf:li>government performance</rdf:li>
               <rdf:li>quality of public finance</rdf:li>
            </rdf:Bag>
         </dc:subject>
