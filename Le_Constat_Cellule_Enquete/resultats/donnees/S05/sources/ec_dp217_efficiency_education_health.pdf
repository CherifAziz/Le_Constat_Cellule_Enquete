               <rdf:li>H40 (Publicly Provided Goods - General)</rdf:li>
               <rdf:li>H51 (National Government Expenditures and Health)</rdf:li>
               <rdf:li>H52 (National Government Expenditures and Education)</rdf:li>
               <rdf:li>I11 (Analysis of Health Care Markets)</rdf:li>
               <rdf:li>I21 (Analysis of Education)</rdf:li>
               <rdf:li>-------------------------------</rdf:li>
               <rdf:li>Efficiency analysis</rdf:li>
               <rdf:li>SFA</rdf:li>
               <rdf:li>DEA</rdf:li>
               <rdf:li>Malmquist index</rdf:li>
