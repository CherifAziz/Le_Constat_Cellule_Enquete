					<tr>
						<td style="width:28.85pt; border-top:0.75pt solid #0070b9; border-right:0.75pt solid #0070b9; border-bottom:0.75pt solid #0070b9; padding:1.4pt 1.02pt">
							<p class="assnatligneTableauC" style="text-align:center">
								141
							</p>
						</td>
						<td style="width:84.55pt; border:0.75pt solid #0070b9; padding:1.4pt 1.02pt">
							<p class="assnatligneTableauC">
								Art. L. 136-1 à L. 136-8 du code de la sécurité sociale et 1600-0-C et 1600-0-D du code général des impôts
							</p>
						</td>
						<td style="width:100.95pt; border:0.75pt solid #0070b9; padding:1.4pt 1.02pt">
							<p class="assnatligneTableauC">
								Contribution sociale généralisée (CSG)
							</p>
						</td>
						<td style="width:91.1pt; border:0.75pt solid #0070b9; padding:1.4pt 1.02pt">
							<p class="assnatligneTableauC">
								Unédic
							</p>
						</td>
						<td style="width:56.6pt; border:0.75pt solid #0070b9; padding:1.4pt 1.02pt">
							<p class="assnatligneTableauC" style="text-align:center">
								-
							</p>
						</td>
						<td style="width:60.7pt; border:0.75pt solid #0070b9; padding:1.4pt 1.02pt">
							<p class="assnatligneTableauC" style="text-align:center">
								18<span style="font-family:'Times New Roman'"> </span>000<span style="font-family:'Times New Roman'"> </span>000<span style="font-family:'Times New Roman'"> </span>000
							</p>
						</td>
						<td style="width:67.9pt; border-top:0.75pt solid #0070b9; border-left:0.75pt solid #0070b9; border-bottom:0.75pt solid #0070b9; padding:1.4pt 1.02pt">
							<p class="assnatligneTableauC" style="text-align:center">
								Non plafonnée
							</p>
						</td>
