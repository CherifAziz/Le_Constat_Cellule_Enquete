				<tr>
					<td style="width:337.7pt; border-top:0.75pt solid #0070b9; border-right:0.75pt solid #0070b9; border-bottom:0.75pt solid #0070b9; padding:1.4pt 1.02pt; vertical-align:middle">
						<p class="assnatligneTableauC">
							Prélèvement sur les recettes de l’État en faveur des communes nouvelles
						</p>
					</td>
					<td style="width:87.95pt; border-top:0.75pt solid #0070b9; border-left:0.75pt solid #0070b9; border-bottom:0.75pt solid #0070b9; padding:1.4pt 1.02pt; vertical-align:middle">
						<p class="assnatligneTableauC">
							33 201 983
						</p>
					</td>
				</tr>
				<tr>
					<td style="width:337.7pt; border-top:0.75pt solid #0070b9; border-right:0.75pt solid #0070b9; border-bottom:0.75pt solid #0070b9; padding:1.4pt 1.02pt; vertical-align:middle">
						<p class="assnatligneTableauC">
							Prélèvement sur les recettes de l’État au titre de la compensation et du lissage des pertes exceptionnelles de recettes de taxe foncière sur les propriétés bâties
						</p>
