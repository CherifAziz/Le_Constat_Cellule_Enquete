								<td style="width:47.35pt; border-top:0.75pt solid #0070b9; border-left:0.75pt solid #0070b9; padding:1.4pt 0pt 0pt 1.02pt; vertical-align:middle">
									<p class="assnatligneTableau" style="text-align:center">
