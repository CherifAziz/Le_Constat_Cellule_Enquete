					<td style="width:33.2pt; border-top:0.75pt solid #0070b9; border-left:0.75pt solid #0070b9; border-bottom:0.75pt solid #0070b9; padding:1.4pt 1.02pt; vertical-align:middle">
						<p class="assnatligneTableauC" style="text-align:right">
							2,5
						</p>
					</td>
				</tr>
				<tr>
					<td style="width:405.2pt; border-top:0.75pt solid #0070b9; border-right:0.75pt solid #0070b9; border-bottom:0.75pt solid #0070b9; padding:1.4pt 1.02pt; vertical-align:middle">
						<p class="assnatligneTableauC">
							Autres ressources de trésorerie
						</p>
