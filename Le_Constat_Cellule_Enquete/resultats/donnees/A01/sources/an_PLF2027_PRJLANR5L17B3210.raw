					<td style="width:71.6pt; border-top:0.75pt solid #0070b9; border-right:0.75pt solid #0070b9; border-left:0.75pt solid #0070b9; padding:1.4pt 1.02pt; vertical-align:middle">
						<p class="assnatligneTableauC" style="text-align:center">
							Aide publique au développement
						</p>
					</td>
					<td style="width:64.7pt; border-top:0.75pt solid #0070b9; border-right:0.75pt solid #0070b9; border-left:0.75pt solid #0070b9; padding:1.4pt 1.02pt; vertical-align:middle">
						<p class="assnatligneTableauC" style="text-align:center">
							370
						</p>
					</td>
					<td style="width:76.7pt; border-top:0.75pt solid #0070b9; border-right:0.75pt solid #0070b9; border-left:0.75pt solid #0070b9; padding:1.4pt 1.02pt; vertical-align:middle">
						<p class="assnatligneTableauC" style="text-align:center">
							Restitution des « biens mal acquis »
						</p>
					</td>
					<td style="width:78.2pt; border-top:0.75pt solid #0070b9; border-left:0.75pt solid #0070b9; padding:1.4pt 1.02pt; vertical-align:middle">
						<p class="assnatligneTableauC" style="text-align:center">
							Aide publique au développement
